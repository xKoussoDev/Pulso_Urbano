{
  "expo": {
    "name": "Pulso Urbano",
    "slug": "inteligencia-urbana",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/pulso-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F7FB",
        "foregroundImage": "./assets/pulso-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/pulso-icon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Permite que Pulso Urbano use el micrófono para describir un problema."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite elegir fotografías ficticias para acompañar tu reporte.",
          "cameraPermission": "Permite tomar fotografías ficticias para acompañar tu reporte."
        }
      ]
    ]
  }
}
